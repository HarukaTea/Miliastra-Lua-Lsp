+
+std::optional<Luau::RequireSuggestions> StringRequireSuggester::getRequireSuggestionsImpl(
+    const Luau::ModuleName& name, const std::optional<std::string>& path) const
+{
+    auto standard = Luau::RequireSuggester::getRequireSuggestionsImpl(name, path);
+    if (!path || !RuntimeModulePaths::accepts(*path) || *path == "." || *path == "..")
+        return standard;
+    auto script = platform->resolveToRealPath(name);
+    if (!script)
+        return standard;
+    auto results = RuntimeModulePaths(workspaceFolder->fileResolver, *script).suggest(*path, *workspaceFolder);
+    if (standard)
+    {
+        std::unordered_set<std::string> paths;
+        for (const auto& item : results)
+            paths.insert(item.fullPath);
+        for (auto& item : *standard)
+            if (paths.insert(item.fullPath).second)
+                results.push_back(std::move(item));
+    }
+    return results;
+}
