-    return frontend.loadDefinitionFile(globals, globals.globalScope, definitions, packageName, /* captureComments = */ true);
+    auto result = frontend.loadDefinitionFile(globals, globals.globalScope, definitions, packageName, /* captureComments = */ true);
+    if (result.success && packageName == "@miliastra")
+    {
+        // Miliastra uses a restricted Lua 5.3 runtime, not Luau's runtime libraries.
+        for (const char* name : {"io", "coroutine", "buffer", "vector", "gcinfo", "getfenv", "setfenv", "newproxy", "loadstring", "unpack"})
+            globals.globalScope->bindings.erase(globals.globalNames.names->getOrAdd(name));
+
+        auto restrictLibrary = [&](const char* name, std::initializer_list<const char*> members)
+        {
+            auto binding = Luau::tryGetGlobalBinding(globals, name);
+            if (!binding)
+                return;
+            if (auto table = Luau::getMutable<Luau::TableType>(Luau::follow(binding->typeId)))
+            {
+                for (auto it = table->props.begin(); it != table->props.end();)
+                {
+                    if (std::find(members.begin(), members.end(), it->first) == members.end())
+                        it = table->props.erase(it);
+                    else
+                        ++it;
+                }
+            }
+        };
+        restrictLibrary("debug", {"traceback"});
+        restrictLibrary("os", {"time", "date", "clock", "difftime"});
+        restrictLibrary("table", {"concat", "insert", "move", "pack", "remove", "sort", "unpack"});
+        restrictLibrary("string", {"byte", "char", "find", "format", "gmatch", "gsub", "len", "lower", "match", "pack", "packsize", "rep", "reverse", "sub", "unpack", "upper"});
+
+        // Make Enum.EaseType usable as an annotation as well as a value namespace.
+        const auto& types = globals.globalScope->exportedTypeBindings;
+        auto base = types.find("EnumItem");
+        if (base != types.end())
+        {
+            auto& enums = globals.globalScope->importedTypeBindings["Enum"];
+            for (const auto& [name, binding] : types)
+            {
+                auto item = Luau::get<Luau::ExternType>(binding.type);
+                if (item && item->parent == base->second.type && Luau::startsWith(name, "Enum"))
+                    enums.insert_or_assign(name.substr(4), binding);
+            }
+        }
+    }
+    return result;
 }
 
