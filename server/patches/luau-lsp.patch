 #include "Luau/FileResolver.h"
 #include "Platform/StringRequireSuggester.hpp"
 #include "LSP/Workspace.hpp"
+#include "LSP/Utils.hpp"
 #include "LuauFileUtils.hpp"

+RuntimeModulePaths::RuntimeModulePaths(WorkspaceFileResolver& resolver, const Uri& script)
+    : base(script.parent())
+    , resolver(resolver)
+{
+    ClientRequireConfiguration config;
+    if (resolver.client)
+        config = resolver.client->getConfiguration(resolver.rootUri).require;
+    if (base && isInitLuauFile(script) && !config.useOriginalRequireByStringSemantics)
+        base = base->parent();
+    if (!base)
+        return;
+    for (auto& pattern : config.modulePaths)
+    {
+        std::replace(pattern.begin(), pattern.end(), '\\', '/');
+        searchPaths.emplace_back(*base, pattern);
+        if (*base != resolver.rootUri && !Luau::FileUtils::isAbsolutePath(pattern))
+            searchPaths.emplace_back(resolver.rootUri, pattern);
+    }
+}
+
+bool RuntimeModulePaths::accepts(const std::string& path)
+{
+    return path.empty() || (path.front() != '@' && !Luau::FileUtils::isAbsolutePath(path) &&
+        !Luau::startsWith(path, "./") && !Luau::startsWith(path, "../") && !Luau::startsWith(path, ".\\") &&
+        !Luau::startsWith(path, "..\\") && !endsWith(path, ".lua") && !endsWith(path, ".luau"));
+}
+
+static std::string expandModulePath(std::string pattern, const std::string& module)
+{
+    for (size_t pos = pattern.find('?'); pos != std::string::npos; pos = pattern.find('?', pos + module.size()))
+        pattern.replace(pos, 1, module);
+    return pattern;
+}
+
+static std::string moduleDirectoryPath(std::string path)
+{
+    std::replace(path.begin(), path.end(), '.', '/');
+    std::replace(path.begin(), path.end(), '\\', '/');
+    return path;
+}
+
+std::optional<Uri> RuntimeModulePaths::resolve(const std::string& path) const
+{
+    const auto module = moduleDirectoryPath(path);
+    for (const auto& [root, pattern] : searchPaths)
+    {
+        auto candidate = root.resolvePath(expandModulePath(pattern, module));
+        if (resolver.getTextDocument(candidate) || candidate.isFile())
+            return candidate;
+    }
+    return std::nullopt;
+}
+
+// Invert a single filename component, including templates where '?' occurs more than once.
+static std::optional<std::string> matchModuleComponent(const std::string& pattern, const std::string& filename)
+{
+    const auto count = static_cast<size_t>(std::count(pattern.begin(), pattern.end(), '?'));
+    const auto fixed = pattern.size() - count;
+    if (filename.size() <= fixed || (filename.size() - fixed) % count != 0)
+        return std::nullopt;
+    auto name = filename.substr(pattern.find('?'), (filename.size() - fixed) / count);
+    return expandModulePath(pattern, name) == filename ? std::optional(name) : std::nullopt;
+}
+
+Luau::RequireSuggestions RuntimeModulePaths::suggest(const std::string& path, const WorkspaceFolder& workspace) const
+{
+    const auto separator = path.find_last_of("./\\");
+    const std::string prefix = path.substr(0, separator + 1);
+    const std::string typed = path.substr(prefix.size());
+    const auto moduleDir = moduleDirectoryPath(prefix);
+    Luau::RequireSuggestions results;
+    std::unordered_set<std::string> files, folders;
+    std::unordered_map<Uri, std::vector<std::pair<std::string, bool>>, UriHash> entries;
+
+    for (const auto& [root, pattern] : searchPaths)
+    {
+        // The first '?' identifies the only directory that must be listed for this component.
+        // The rest of the template is checked against the real target (e.g. ?/init.lua or ?/?.lua).
+        const auto partialPattern = expandModulePath(pattern, moduleDir + "?");
+        const auto wildcard = partialPattern.find('?');
+        if (wildcard == std::string::npos)
+            continue;
+        const auto start = partialPattern.rfind('/', wildcard) + 1;
+        const auto end = partialPattern.find('/', wildcard);
+        const auto component = partialPattern.substr(start, end - start);
+        const auto fixedPrefix = partialPattern.substr(start, wildcard - start);
+        const auto directory = root.resolvePath(partialPattern.substr(0, start));
+        auto [it, added] = entries.try_emplace(directory);
+        auto& children = it->second;
+        if (added && directory.isDirectory())
+            Luau::FileUtils::traverseDirectory(directory.fsPath(), [&](const std::string& child) {
+                auto uri = Uri::file(child);
+                if (!workspace.isIgnoredFileForAutoImports(uri))
+                    children.emplace_back(uri.filename(), uri.isDirectory());
+            });
+
+        for (const auto& [filename, isDirectory] : children)
+        {
+            if (!Luau::startsWith(filename, fixedPrefix + typed))
+                continue;
+            if (isDirectory)
+            {
+                // A directory can also be the beginning of a longer module name.
+                const auto child = filename.substr(fixedPrefix.size());
+                if (!child.empty() && child.find('.') == std::string::npos)
+                    folders.insert(child);
+            }
+            auto name = matchModuleComponent(component, filename);
+            if (!name || name->find('.') != std::string::npos || !Luau::startsWith(*name, typed) || files.count(*name))
+                continue;
+            const auto target = root.resolvePath(expandModulePath(pattern, moduleDir + *name));
+            if (resolver.getTextDocument(target) || target.isFile())
+            {
+                files.insert(*name);
+                results.push_back({*name, prefix + *name, {"File"}});
+            }
+        }
+    }
+    for (const auto& name : folders)
+        if (!files.count(name))
+            results.push_back({name, prefix + name, {"Directory"}});
+    return results;
+}
 
