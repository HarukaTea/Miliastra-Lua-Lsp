+// Recognize shifts only in expressions. Keep the lexer unchanged so nested
+// generic types (A<B<C>>) and union/intersection annotations retain their tokens.
+Parser::BitOperator Parser::bitOperator()
+{
+    const Lexeme& token = lexer.current();
+    const auto ch = token.type;
+    if (ch == '~')
+        return {"bxor", 5, false, false};
+    if (ch != '&' && ch != '|' && ch != '<' && ch != '>')
+        return {};
+    const auto next = lexer.lookahead();
+    const bool adjacent = token.location.end == next.location.begin;
+    if (ch == '<' || ch == '>')
+    {
+        bool assign = next.type == (ch == '<' ? Lexeme::LessEqual : Lexeme::GreaterEqual);
+        if (adjacent && (next.type == ch || assign))
+            return {ch == '<' ? "lshift" : "rshift", 7, true, assign};
+        return {};
+    }
+    if (adjacent && next.type == ch)
+        return {}; // preserve the normal diagnostic for && and ||
+    bool assign = adjacent && next.type == '=';
+    return {ch == '&' ? "band" : "bor", ch == '&' ? 6u : 4u, assign, assign};
+}
+
+// Adjacent f<<T>>(...) is an explicit Luau type application. Look ahead only
+// when the first token could start a type; ordinary numeric shifts take the fast path.
+bool Parser::isExplicitTypeCall(const Position& calleeEnd) const
+{
+    if (lexer.current().type != '<' || calleeEnd != lexer.current().location.begin)
+        return false;
+    Lexer probe = lexer;
+    if (probe.next().type != '<')
+        return false;
+    unsigned int depth = 2;
+    unsigned int brackets = 0;
+    for (;;)
+    {
+        const auto& token = probe.next();
+        if (token.type == Lexeme::Eof)
+            return false;
+        // typeof expressions can contain literals, comparisons and function bodies.
+        // Only inspect angle brackets and expression boundaries outside nested delimiters.
+        if (token.type == '(' || token.type == '{' || token.type == '[')
+            ++brackets;
+        else if (token.type == ')' || token.type == '}' || token.type == ']')
+        {
+            if (brackets == 0)
+                return false;
+            --brackets;
+        }
+        else if (brackets != 0)
+            continue;
+        else if (token.type == '<')
+            ++depth;
+        else if (token.type == '>' && --depth == 0)
+            return probe.next().type == '(';
+        else if (token.type == Lexeme::Number || token.type == '=' ||
+                 token.type == ';' || token.type == Lexeme::ReservedLocal || token.type == Lexeme::ReservedReturn)
+            return false;
+    }
+}
+
+// This server analyzes game code; it never executes the rewritten AST.
+// Keep both operands at their actual positions for diagnostics and navigation.
+AstExpr* Parser::makeBitCall(const Location& op, const char* function, AstExpr* lhs, AstExpr* rhs)
+{
+    auto base = allocator.alloc<AstExprGlobal>(op, names.getOrAdd("bit32"));
+    auto callee = allocator.alloc<AstExprIndexName>(op, base, names.getOrAdd(function), op, op.begin, '.');
+    auto args = lhs ? copy({lhs, rhs}) : copy({rhs});
+    Location location(lhs ? lhs->location.begin : op.begin, rhs->location.end);
+    return allocator.alloc<AstExprCall>(location, callee, args, false, AstArray<AstTypeOrPack>{}, location);
+}
