+bool Parser::startsLabelAfterExpression() const
+{
+    Lexer probe = lexer;
+    if (probe.next().type != Lexeme::Name || probe.next().type != Lexeme::DoubleColon)
+        return false;
+    // In "value :: Type  ::label::" the first double colon is a Luau cast.
+    return probe.next().type != Lexeme::Name || probe.next().type != Lexeme::DoubleColon;
