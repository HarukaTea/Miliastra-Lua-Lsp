{
	"activationEvents": [
		"onLanguage:lua"
	],
	"author": "HarukaTea",
	"repository": {
		"type": "git",
		"url": "https://github.com/HarukaTea/Miliastra-Lua-Lsp.git"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"categories": [
		"Linters"
	],
	"contributes": {
		"configuration": {
			"properties": {
				"miliastraLsp.color.mode": {
					"default": "Semantic",
					"enum": [
						"Grammar",
						"Semantic"
					],
					"markdownDescription": "%config.color.mode%",
					"markdownEnumDescriptions": [
						"%config.color.mode.Grammar%",
						"%config.color.mode.Semantic%"
					],
					"scope": "resource",
					"type": "string"
				},
				"miliastraLsp.completion.callParenthesess": {
					"default": false,
					"markdownDescription": "%config.completion.callParenthesess%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.completion.enable": {
					"default": true,
					"markdownDescription": "%config.completion.enable%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.completion.showParams": {
					"default": true,
					"markdownDescription": "%config.completion.showParams%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.completion.endAutocompletion": {
					"default": false,
					"markdownDescription": "%config.completion.endAutocompletion%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.completion.deprecatedMembers": {
					"default": false,
					"markdownDescription": "%config.completion.deprecatedMembers%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.completion.alwaysShowMethods": {
					"default": false,
					"markdownDescription": "%config.completion.alwaysShowMethods%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.diagnostics.enable": {
					"default": true,
					"markdownDescription": "%config.diagnostics.enable%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.hint.enable": {
					"default": false,
					"markdownDescription": "%config.hint.enable%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.hint.paramName": {
					"default": false,
					"markdownDescription": "%config.hint.paramName%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.hint.paramType": {
					"default": true,
					"markdownDescription": "%config.hint.paramType%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.hint.variableType": {
					"default": true,
					"markdownDescription": "%config.hint.variableType%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.hint.returnType": {
					"default": false,
					"markdownDescription": "%config.hint.returnType%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.runtime.path": {
					"default": [
						"?.lua",
						"?/init.lua",
						"?/?.lua",
						"?.luau",
						"?/init.luau",
						"?/?.luau"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "%config.runtime.path%",
					"scope": "resource",
					"type": "array"
				},
				"miliastraLsp.signatureHelp.enable": {
					"default": true,
					"markdownDescription": "%config.signatureHelp.enable%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.window.statusBar": {
					"default": true,
					"markdownDescription": "%config.window.statusBar%",
					"scope": "resource",
					"type": "boolean"
				},
				"miliastraLsp.workspace.ignoreDir": {
					"default": [
						".vscode",
						"**/_Index/**"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "%config.workspace.ignoreDir%",
					"scope": "resource",
					"type": "array"
				},
				"miliastraLsp.workspace.maxPreload": {
					"default": 1000,
					"markdownDescription": "%config.workspace.maxPreload%",
					"scope": "resource",
					"type": "integer"
				}
			},
			"title": "千星奇域 Lua LSP",
			"type": "object"
		},
		"languages": [
			{
				"id": "lua",
				"aliases": [
					"Luau"
				],
				"extensions": [
					".lua",
					".luau"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "lua",
				"path": "./syntaxes/lua.tmLanguage.json",
				"scopeName": "source.lua"
			}
		],
		"semanticTokenModifiers": [
			{
				"id": "primitive",
				"description": "primitive types"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "lua",
				"scopes": {
					"interface.declaration": [
						"entity.name.function.lua"
					],
					"namespace.deprecated": [
						"entity.name.label"
					],
					"namespace.readonly": [
						"constant.language.lua"
					],
					"namespace.static": [
						"support.function.lua"
					],
					"parameter.declaration": [
						"variable.parameter"
					],
					"property.declaration": [
						"variable.other.property.js"
					],
					"variable": [
						"variable.other.lua"
					],
					"variable.abstract": [
						"variable.other.constant.lua"
					],
					"variable.static": [
						"variable.other.constant.lua"
					],
					"type.primitive": [
						"support.type.primitive.lua"
					]
				}
			}
		]
	},
	"description": "千星奇域 Lua 语言服务，提供运行时 API 补全、跳转和类型诊断。",
	"displayName": "千星奇域 Lua LSP",
	"engines": {
		"vscode": "^1.74.0"
	},
	"icon": "images/miliastra-lua.png",
	"keywords": [
		"Lua",
		"IntelliSense",
		"千星奇域",
		"Miliastra"
	],
	"license": "MIT",
	"main": "./client/out/extension",
	"name": "miliastraLsp",
	"publisher": "HarukaTea",
	"version": "0.1.6",
	"dependencies": {
		"vscode-languageclient": "8.0.2"
	},
	"devDependencies": {
		"@types/node": "17.0.45",
		"@types/vscode": "1.74.0",
		"typescript": "4.9.5"
	},
	"scripts": {
		"compile": "tsc -p client",
		"vscode:prepublish": "npm run compile",
		"build:server": "node scripts/build-server.js"
	}
}
